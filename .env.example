# Serena — Oxalic Lab's Discord assistant
# Copy this file to .env and fill in every value marked REPLACE_ME.
BOT_TOKEN=REPLACE_ME_DISCORD_BOT_TOKEN
BOT_NAME=Serena
COMMUNITY_NAME=Oxalic Lab's
OWNER_IDS=1410852730427277374

# Discord server and channel IDs (enable Developer Mode in Discord to copy IDs).
GUILD_ID=REPLACE_ME_GUILD_ID
VOICE_CHANNEL_ID=REPLACE_ME_VOICE_CHANNEL_ID
STATUS_CHANNEL_ID=REPLACE_ME_STATUS_CHANNEL_ID
REVIEW_CHANNEL_ID=REPLACE_ME_REVIEW_CHANNEL_ID
WELCOME_CHANNEL_ID=REPLACE_ME_WELCOME_CHANNEL_ID
CHAT_CHANNEL_ID=REPLACE_ME_CHAT_CHANNEL_ID

SUPPORT_URL=https://discord.gg/REPLACE_ME
WEBSITE_URL=https://example.com
TERMS_URL=https://example.com/terms
PRIVACY_URL=https://example.com/privacy

# Custom status messages rotate every 5 seconds. The bot stays Online.
# Latin letters and digits are automatically converted to Unicode bold.
ACTIVITIES=Managing Oxalic Lab's,Oxalic Lab's forge the future,Building the future with Oxalic Lab's,Powering projects at Oxalic Lab's,Creating coding and innovating,Where ideas become reality,Growing together at Oxalic Lab's,Engineering what's next,Driven by code united by ideas,Oxalic Lab's | Innovate. Build. Grow.

# Only OFFLINE counts as unavailable. Online, Idle and DND are all available.
# A missing Discord presence cache entry is treated as unknown, not Offline.
MONITORED_BOTS=[{"name":"Hydrogen","id":"1516109847358079050"},{"name":"Wavieo","id":"1517871680607879168"},{"name":"Wavieo Air","id":"1513011778165014569"},{"name":"Oxygen","id":"1481514344377221180"}]

# Gemini API key for all chat, vision, routing and web-answer synthesis
GEMINI_API_KEY=REPLACE_ME_GEMINI_API_KEY

# Cloudflare Workers AI credentials (image generation only)
CLOUDFLARE_ACCOUNT_ID=REPLACE_ME_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=REPLACE_ME_CLOUDFLARE_API_TOKEN

# Tavily Search API (required for live web search)
TAVILY_API_KEY=REPLACE_ME_TAVILY_API_KEY

# Gemini models (chat, vision, routing and web-answer synthesis only)
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_EMERGENCY_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_WEB_MODEL=gemini-3.8-flash

# Cloudflare model (image generation only)
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-dev

